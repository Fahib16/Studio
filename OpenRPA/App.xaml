<Application x:Class="OpenRPA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenRPA" Exit="Application_Exit"
             xmlns:resx="clr-namespace:OpenRPA.Properties"
             ShutdownMode="OnMainWindowClose"
             Startup="Application_Startup"
             StartupUri="MainWindow.xaml"
             >
    <!--StartupUri="MainWindow.xaml"-->
    <!-- 
    StartupUri="MainWindow.xaml"
    StartupUri="Views/SiginWindow.xaml"
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Tema JakForge dipasang di level aplikasi supaya semua window
                (Loading, daftar proyek, editor kanvas) memakai satu sumber
                warna dan huruf yang sama. Isinya hanya resource ber-x:Key,
                tidak ada style implisit, jadi tampilan bawaan OpenRPA tidak
                ikut berubah kecuali memang dirujuk.
            -->
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Paletnya harus SEBELUM JakForge.xaml: gaya di sana merujuk
                    kuas yang didefinisikan di sini. Palet terang dipasang
                    sebagai bawaan; StudioTheming menukarnya kalau setelan
                    bersama meminta gelap.
                -->
                <ResourceDictionary Source="/OpenRPA;component/Themes/JakForgePalette.Light.xaml" />
                <ResourceDictionary Source="/OpenRPA;component/Themes/JakForge.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--You have to add other style here only-->

        </ResourceDictionary>
         
    </Application.Resources>
    
</Application>
