<Window x:Class="OpenRPA.Views.JakForgeLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JakForge"
        Width="520" Height="740"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource JF.Cream}">

    <!--
        Layar Loading, mengikuti frame "Loading" di mockup.

        Ukuran dan jarak antarelemen bukan kira-kira: kotak batas tiap elemen
        di mockup diukur per piksel (logo, wordmark, subtitle, batang progres),
        lalu diskalakan ke jendela 520x740. Logo dan wordmark dipotong langsung
        dari mockup sebagai gambar supaya bentuknya sama persis, tidak
        bergantung pada font yang kebetulan terpasang di mesin ini.
    -->

    <Border BorderBrush="{DynamicResource JF.Border}" BorderThickness="1">
        <!--
            Isi layar digambar pada kanvas tetap 520x740 (ukuran rancangan),
            lalu Viewbox menskalakannya mengikuti ukuran jendela. Dengan begitu
            di layar yang lebih pendek dari 740 piksel tata letaknya menyusut
            utuh, bukan terpotong di bawah.
        -->
        <Viewbox Stretch="Uniform">
        <Grid Width="520" Height="740">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,255,0,0">

                <Image Source="/OpenRPA;component/Resources/JakForge/logo_mark.png"
                       Height="136" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <Image Source="/OpenRPA;component/Resources/JakForge/logo_wordmark.png"
                       Width="212" Margin="0,20,0,0" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock x:Name="StatusText" Text="Memulai workspace Anda..."
                           Margin="0,40,0,0" HorizontalAlignment="Center"
                           FontFamily="{DynamicResource JF.FontBody}" FontSize="14"
                           Foreground="{DynamicResource JF.Brown900}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" TextAlignment="Center" />

                <!--
                    Batang progres berjalan: sepotong isian bergerak dari kiri
                    ke kanan lalu masuk lagi dari kiri.

                    Versi sebelumnya melebarkan isian dari 40 ke 297 lalu
                    mengulang, dan pengulangannya terlihat sebagai lompatan.
                    Menggeser posisi tidak punya titik balik, jadi gerakannya
                    mulus. Menganimasikan RenderTransform juga tidak memicu
                    perhitungan tata letak ulang tiap bingkai.
                -->
                <Border Width="297" Height="10" Margin="0,30,0,0"
                        CornerRadius="5" Background="{DynamicResource JF.Track}"
                        ClipToBounds="True">
                    <Border x:Name="ProgressFill" Width="110" HorizontalAlignment="Left"
                            CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource JF.Color.Track}" Offset="0" />
                                <GradientStop Color="{DynamicResource JF.Color.TrackFill}" Offset="0.5" />
                                <GradientStop Color="{DynamicResource JF.Color.Track}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgressSlide" X="-110" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ProgressSlide"
                                                         Storyboard.TargetProperty="X"
                                                         From="-110" To="297" Duration="0:0:1.5"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>

                <!-- Cincin titik kecil di bawah batang progres, sama seperti di mockup -->
                <Canvas Width="28" Height="28" Margin="0,26,0,0" HorizontalAlignment="Center">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="14" CenterY="14" />
                    </Canvas.RenderTransform>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Canvas.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1.1"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                    <Ellipse Canvas.Left="12" Canvas.Top="0"  Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="1.0" />
                    <Ellipse Canvas.Left="20" Canvas.Top="3"  Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.85" />
                    <Ellipse Canvas.Left="24" Canvas.Top="12" Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.7" />
                    <Ellipse Canvas.Left="20" Canvas.Top="20" Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.55" />
                    <Ellipse Canvas.Left="12" Canvas.Top="24" Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.42" />
                    <Ellipse Canvas.Left="4"  Canvas.Top="20" Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.32" />
                    <Ellipse Canvas.Left="0"  Canvas.Top="12" Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.24" />
                    <Ellipse Canvas.Left="4"  Canvas.Top="3"  Width="4" Height="4" Fill="{DynamicResource JF.Tan}" Opacity="0.16" />
                </Canvas>

            </StackPanel>
        </Grid>
        </Viewbox>
    </Border>
</Window>
