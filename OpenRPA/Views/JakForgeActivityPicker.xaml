<Window x:Class="OpenRPA.Views.JakForgeActivityPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sisipkan activity"
        Width="420" Height="470"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource JF.Surface}">

    <!--
        Kotak cari activity yang muncul saat tombol "+" di kanvas diklik.

        Daftarnya diambil dari toolbox yang sama persis dengan yang ada di
        panel kiri, jadi tidak mungkin ada activity yang bisa diseret tetapi
        tidak bisa disisipkan lewat sini, atau sebaliknya.
    -->

    <Border BorderBrush="{DynamicResource JF.Border}" BorderThickness="1" CornerRadius="10">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource JF.Brown700}" CornerRadius="9,9,0,0" Padding="16,12">
                <TextBlock Text="Sisipkan activity" Foreground="{DynamicResource JF.Cream}"
                           FontFamily="{DynamicResource JF.FontDisplay}" FontSize="15" FontWeight="Bold" />
            </Border>

            <Border Grid.Row="1" Padding="14,12,14,8">
                <Border Background="{DynamicResource JF.Panel}" BorderBrush="{DynamicResource JF.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M10.5,4 A6.5,6.5 0 1,0 10.51,4 Z M15.2,15.2 L20,20"
                              Stroke="{DynamicResource JF.TextMuted}" StrokeThickness="1.5"
                              Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="9,0,0,0" BorderThickness="0"
                                 Background="Transparent" FontSize="14"
                                 FontFamily="{DynamicResource JF.FontBody}"
                                 Foreground="{DynamicResource JF.Brown900}"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    </Grid>
                </Border>
            </Border>

            <ListBox x:Name="Results" Grid.Row="2" Margin="8,0,8,8" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Results_MouseDoubleClick" PreviewKeyDown="Results_PreviewKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource JF.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource JF.Brown700}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource JF.Cream}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="13.5"
                                           FontFamily="{DynamicResource JF.FontBody}" />
                                <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.65"
                                           FontFamily="{DynamicResource JF.FontBody}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
