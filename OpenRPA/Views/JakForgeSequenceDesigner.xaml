<sap:ActivityDesigner x:Class="OpenRPA.Views.JakForgeSequenceDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    Template="{DynamicResource JF.SequenceTemplate}">

    <!--
        Sequence versi JakForge.

        Dua alasan menggantikan designer bawaan:

        1. Warnanya. Sequence bawaan memakai abu-abu biru Visual Studio yang
           tidak nyambung dengan kartu activity lain.

        2. Tombol "+" di antara activity. Bawaan hanya menyediakan segitiga
           kecil sebagai penanda tempat jatuh saat menyeret. Dengan tombol ini,
           activity bisa disisipkan tepat di titik yang diklik tanpa harus
           menyeret dari toolbox, seperti di UiPath.
    -->

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenRPA;component/Themes/JakForge.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Bingkai kartu Sequence: tanpa bilah abu-abu bawaan -->
            <ControlTemplate x:Key="JF.SequenceTemplate" TargetType="{x:Type sap:ActivityDesigner}">
                <Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent"
                        BorderThickness="2" CornerRadius="10" Padding="1" SnapsToDevicePixels="True">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource JF.Border}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource JF.Tan}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!--
                Penyisip antar-activity. Panah tetap digambar supaya alur tetap
                terbaca dari atas ke bawah; tombol bulat muncul di tengahnya.
            -->
            <DataTemplate x:Key="JF.Spacer">
                <Grid Height="26" HorizontalAlignment="Center">
                    <Path Data="M9,0 L9,14 M4,10 L9,15 L14,10" Stroke="{DynamicResource JF.Tan}"
                          StrokeThickness="1.3" Width="18" Height="17" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Click="InsertHere_Click" Width="18" Height="18" Cursor="Hand"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip="Sisipkan activity di sini">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="bg" Fill="{DynamicResource JF.Cream}"
                                             Stroke="{DynamicResource JF.Tan}" StrokeThickness="1.2" />
                                    <Path x:Name="plus" Data="M9,4.5 L9,13.5 M4.5,9 L13.5,9"
                                          Stroke="{DynamicResource JF.Brown700}" StrokeThickness="1.5"
                                          Width="18" Height="18" Stretch="None" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Fill" Value="{DynamicResource JF.Brown700}" />
                                        <Setter TargetName="plus" Property="Stroke" Value="{DynamicResource JF.Cream}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="198">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource JF.Brown700}" CornerRadius="8,8,0,0" Padding="9,5">
            <StackPanel Orientation="Horizontal">
                <Path Data="M4,5 H16 M4,10 H16 M4,15 H16" Stroke="{DynamicResource JF.Cream}"
                      StrokeThickness="1.6" Width="20" Height="20" Stretch="None"
                      VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="{DynamicResource JF.Cream}" FontWeight="Bold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="105" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource JF.Surface}" BorderBrush="{DynamicResource JF.Border}"
                BorderThickness="1" CornerRadius="0,0,8,8" Padding="10,7">
            <sap:WorkflowItemsPresenter x:Name="Items"
                                        Items="{Binding Path=ModelItem.Activities}"
                                        HintText="Letakkan activity di sini, atau klik tombol + "
                                        SpacerTemplate="{DynamicResource JF.Spacer}">
                <sap:WorkflowItemsPresenter.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </sap:WorkflowItemsPresenter.ItemsPanel>
            </sap:WorkflowItemsPresenter>
        </Border>
    </Grid>
</sap:ActivityDesigner>
