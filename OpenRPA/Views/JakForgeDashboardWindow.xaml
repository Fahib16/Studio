<Window x:Class="OpenRPA.Views.JakForgeDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JakForge"
        Icon="/OpenRPA;component/Resources/JakForge/jakforge.ico"
        Width="1180" Height="780"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource JF.Surface}">

    <!--
        Frame "Project List & Settings" dari mockup.

        Yang ditampilkan adalah proyek SUNGGUHAN milik OpenRPA
        (RobotInstance.instance.Projects), bukan contoh. Karena itu baris kedua
        pada kartu berbunyi "Workflow: N" dan bukan "Status: Selesai" seperti di
        gambar: OpenRPA tidak menyimpan status selesai per proyek, jadi menulis
        "Selesai" berarti memajang keterangan yang tidak ada sumbernya.
    -->

    <Window.Resources>

        <!-- Ikon garis, digambar sebagai Path supaya tajam di semua ukuran -->
        <Geometry x:Key="Ico.Home">M4,11 L12,4.5 L20,11 M6,10 L6,19.5 L10.5,19.5 L10.5,14 L13.5,14 L13.5,19.5 L18,19.5 L18,10</Geometry>
        <Geometry x:Key="Ico.Folder">M3.5,18.5 L3.5,6 L9,6 L11,8.5 L20.5,8.5 L20.5,18.5 Z</Geometry>
        <Geometry x:Key="Ico.Template">M4,4.5 L20,4.5 L20,19.5 L4,19.5 Z M4,9.5 L20,9.5 M9.5,9.5 L9.5,19.5</Geometry>
        <!--
            Gigi roda digambar DI LUAR cincin. Versi sebelumnya menarik garis
            yang menembus lingkaran, dan hasilnya terbaca sebagai matahari,
            bukan roda gigi.
        -->
        <Geometry x:Key="Ico.Gear">M12,5.6 A6.4,6.4 0 1,0 12.01,5.6 Z M12,9.2 A2.8,2.8 0 1,0 12.01,9.2 Z M12,3.2 L12,5.3 M12,18.7 L12,20.8 M3.2,12 L5.3,12 M18.7,12 L20.8,12 M6.1,6.1 L7.6,7.6 M16.4,16.4 L17.9,17.9 M17.9,6.1 L16.4,7.6 M7.6,16.4 L6.1,17.9</Geometry>
        <Geometry x:Key="Ico.Help">M12,3.5 A8.5,8.5 0 1,0 12.01,3.5 Z M9.6,9.4 C9.6,7.9 10.7,7 12,7 C13.4,7 14.5,7.9 14.5,9.2 C14.5,11 12,11.3 12,13.2 M12,16.4 L12,16.6</Geometry>
        <Geometry x:Key="Ico.Bell">M12,4 C9.2,4 7.4,5.9 7.4,8.7 L7.4,13 L5.6,15.6 L18.4,15.6 L16.6,13 L16.6,8.7 C16.6,5.9 14.8,4 12,4 Z M10.4,18 C10.7,19 11.3,19.5 12,19.5 C12.7,19.5 13.3,19 13.6,18</Geometry>
        <Geometry x:Key="Ico.Plus">M12,5.5 L12,18.5 M5.5,12 L18.5,12</Geometry>
        <Geometry x:Key="Ico.Doc">M7,3.5 L14.5,3.5 L18,7 L18,20.5 L7,20.5 Z M14.5,3.5 L14.5,7 L18,7 M9.6,11 L15.4,11 M9.6,14 L15.4,14 M9.6,17 L13,17</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource JF.Brown700}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- Satu butir menu di sidebar. Yang terpilih jadi pil cokelat penuh. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource JF.Brown900}" />
            <Setter Property="FontFamily" Value="{DynamicResource JF.FontBody}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="14,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,11">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource JF.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource JF.Brown700}" />
                                <Setter Property="Foreground" Value="{DynamicResource JF.Cream}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kartu proyek: seluruh kartu bisa diklik, jadi dibuat dari Button. -->
        <Style x:Key="ProjectCard" TargetType="Button">
            <Setter Property="Width" Value="264" />
            <Setter Property="Height" Value="198" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource JF.Surface}"
                                BorderBrush="{DynamicResource JF.Border}" BorderThickness="1"
                                CornerRadius="14" Padding="20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource JF.Brown500}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="{DynamicResource JF.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--
                Bilah judul: berlatar krem sama seperti bilah JakForge di jendela
                utama, dengan tombol jendela di kanan. Menyeret bilah ini
                memindahkan jendela.
            -->
            <Border Grid.Row="0" Background="{DynamicResource JF.Cream}"
                    BorderBrush="{DynamicResource JF.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Style="{DynamicResource JF.WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimalkan" />
                    <Button Style="{DynamicResource JF.WindowButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Perbesar" />
                    <Button Style="{DynamicResource JF.WindowButtonClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Tutup" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource JF.Sidebar}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,26,0,26">
                            <Image Source="/OpenRPA;component/Resources/JakForge/logo_mark.png"
                                   Height="30" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image Source="/OpenRPA;component/Resources/JakForge/logo_wordmark.png"
                                   Height="22" Margin="10,2,0,0" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" IsChecked="True"
                                         GroupName="nav" Checked="Nav_Checked" Tag="dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Home}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavRecent" Style="{StaticResource NavItem}"
                                         GroupName="nav" Checked="Nav_Checked" Tag="recent">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Folder}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Proyek Terkini" Margin="14,0,0,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource JF.Tan}" CornerRadius="9" MinWidth="18" Height="18"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="RecentBadge" Text="0" FontSize="11" Margin="6,0"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavTemplate" Style="{StaticResource NavItem}"
                                         GroupName="nav" Checked="Nav_Checked" Tag="template">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Template}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Template" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                         GroupName="nav" Checked="Nav_Checked" Tag="settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Gear}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Pengaturan" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,18">
                            <Border Height="1" Background="{DynamicResource JF.Border}" Margin="24,0,24,14" />
                            <Button Style="{StaticResource JF.GhostButton}" Click="Settings_Click"
                                    HorizontalContentAlignment="Left" Margin="14,2" Padding="14,10"
                                    BorderBrush="Transparent" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Gear}" />
                                    <TextBlock Text="Pengaturan" Margin="14,0,0,0" VerticalAlignment="Center"
                                               FontSize="15" Foreground="{DynamicResource JF.Brown900}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource JF.GhostButton}" Click="Help_Click"
                                    HorizontalContentAlignment="Left" Margin="14,2" Padding="14,10"
                                    BorderBrush="Transparent" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Help}" />
                                    <TextBlock Text="Bantuan" Margin="14,0,0,0" VerticalAlignment="Center"
                                               FontSize="15" Foreground="{DynamicResource JF.Brown900}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Isi utama -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0">
                    <Grid Margin="42,30,42,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Judul + blok pengguna -->
                        <Grid Grid.Row="0">
                            <TextBlock Style="{DynamicResource JF.Heading}" HorizontalAlignment="Left"
                                       MaxWidth="520"><Run Text="Selamat Datang" /><LineBreak /><Run Text="di JakForge" /></TextBlock>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Grid Margin="0,0,18,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Bell}" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource JF.Ok}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" />
                                </Grid>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource JF.Brown500}">
                                    <TextBlock x:Name="UserInitials" Text="?" Foreground="White" FontSize="17"
                                               FontFamily="{DynamicResource JF.FontDisplay}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserName" Text="Pengguna" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource JF.Brown900}"
                                               FontFamily="{DynamicResource JF.FontBody}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse x:Name="UserStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{DynamicResource JF.Ok}" />
                                        <TextBlock x:Name="UserStatus" Text="Online" Margin="6,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource JF.TextMuted}"
                                                   FontFamily="{DynamicResource JF.FontBody}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="1" Style="{DynamicResource JF.PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,26,0,0" Padding="26,14" Click="NewProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Ico.Plus}"
                                      Stroke="{DynamicResource JF.Cream}" Width="20" Height="20" />
                                <TextBlock Text="Buat Proyek Baru" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" />
                            </StackPanel>
                        </Button>

                        <!-- Proyek terkini -->
                        <ItemsControl Grid.Row="2" x:Name="RecentList" Margin="0,26,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <StackPanel Grid.Row="3">
                            <Border Height="1" Background="{DynamicResource JF.Border}" Margin="0,6,0,22" />
                            <TextBlock Text="Proyek" Style="{DynamicResource JF.SectionTitle}" Margin="0,0,0,18" />
                        </StackPanel>

                        <ItemsControl Grid.Row="4" x:Name="ProjectList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
