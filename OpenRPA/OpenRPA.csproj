	<ItemGroup>
		<!--
			Empat paket ini disebut EKSPLISIT bukan karena kodenya memakai
			langsung, tapi supaya versi yang TERSALIN ke folder keluaran sama
			dengan versi yang ditulis di bindingRedirect OpenRPA.exe.config.

			Sebelumnya keduanya berbeda — redirect meminta 9.0.0.0 sementara
			yang tersalin 5.0.0.0, dan seterusnya — sehingga setiap kali
			assembly itu dimuat, .NET melempar FileLoadException "manifest
			definition does not match". Yang paling parah terjadi saat Studio
			memindai tipe activity lewat GetExportedTypes: pemindaian gagal,
			workflow tidak bisa disusun, dan kanvas terbuka KOSONG — sehingga
			tombol Run tidak punya apa pun untuk dijalankan.
		-->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
		<PackageReference Include="System.Memory" Version="4.5.5" />
