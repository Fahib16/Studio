		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NuGet.Common" Version="5.11.6" />
		<PackageReference Include="NuGet.Packaging" Version="5.11.6" />
		<PackageReference Include="NuGet.Protocol" Version="5.11.3" />
		<PackageReference Include="NuGet.Resolver" Version="5.11.3" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.11.1" />
	</ItemGroup>
