		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/open-rpa/openrpa</PackageProjectUrl>
		<Version>1.4.57.13</Version>
		<PackageReleaseNotes></PackageReleaseNotes>
