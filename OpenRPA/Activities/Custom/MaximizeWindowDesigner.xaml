<sap:ActivityDesigner
    x:Class="OpenRPA.Activities.Custom.Design.MaximizeWindowDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    >

    <!-- Icon custom sengaja tidak dipakai (lihat catatan IOException batch sebelumnya) -->

    <sap:ActivityDesigner.Resources>
        <!-- Warna oranye/amber, kategori "Window Control" -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FFEF6C00" />
    </sap:ActivityDesigner.Resources>

    <!-- Minimal ala UiPath: cuma header (ikon + judul), semua property
         (Tab, WindowTitle, TitleMatchMode, ProcessName, ContinueOnError)
         diatur lewat Properties panel saja, tidak ada kotak input di canvas. -->
    <Border Background="{StaticResource HeaderBrush}"
            CornerRadius="3" Padding="10,6" MinWidth="180">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🗖" Foreground="White" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Maximize Window" Foreground="White" FontWeight="Bold" FontSize="13" />
        </StackPanel>
    </Border>
</sap:ActivityDesigner>
