<sap:ActivityDesigner
    x:Class="OpenRPA.Activities.Custom.Design.MaximizeWindowDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >

    <!-- Icon custom sengaja tidak dipakai (lihat catatan IOException batch sebelumnya) -->

    <sap:ActivityDesigner.Resources>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
        <!-- Warna oranye/amber, kategori "Window Control" — beda dari
             UI Automation (biru), Data (hijau), Browser (biru tua), Terminal (hijau tua) -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FFEF6C00" />
    </sap:ActivityDesigner.Resources>

    <Grid Margin="8" MinWidth="240">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗖" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Maximize Window" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1"
                CornerRadius="2" Padding="6" Background="White">
            <StackPanel>
                <TextBlock Text="Window Title (opsional):" FontWeight="SemiBold" Foreground="#FF555555" Margin="0,0,0,2" />
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.WindowTitle, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                    ExpressionType="{x:Type s:String}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="Kosongkan = maximize window aktif saat ini"
                    MaxLines="1" MinLines="1" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Path=ModelItem.TitleMatchMode, StringFormat='Match: {0}'}"
                               FontSize="10" Foreground="#FF888888" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Path=ModelItem.ProcessName.Expression, StringFormat='Process: {0}'}"
                               FontSize="10" Foreground="#FF888888" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
