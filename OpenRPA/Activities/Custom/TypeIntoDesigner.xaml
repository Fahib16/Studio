<sap:ActivityDesigner x:Class="OpenRPA.Activities.TypeIntoDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sa="clr-namespace:System.Activities;assembly=System.Activities"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    Loaded="ActivityDesigner_Loaded"
    >

    <sap:ActivityDesigner.Resources>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <StackPanel Margin="4">
                <TextBlock Text="{Binding Path=ModelItem.Text.Expression}" 
                           Foreground="Gray" FontStyle="Italic" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <DataTemplate x:Key="Expanded">
            <StackPanel Margin="5" MinWidth="280">

                <!-- Target Element Section -->
                <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFF9F9F9" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Peringatan Teknologi -->
                        <TextBlock Text="{Binding Path=ModelItem.Technology, StringFormat='Mode Target: {0}'}" 
                                   FontSize="11" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                        <Button Content="Indicate target on screen" Click="Open_Selector"
                                Cursor="Hand" Padding="8,5" Margin="0,0,0,4"
                                Background="Transparent" Foreground="#FF0054A6"
                                BorderBrush="#FF0054A6" BorderThickness="1" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch" />

                        <Button Click="Highlight_Click" Margin="0,0,0,4"
                                HorizontalAlignment="Stretch" Padding="6,2"
                                Background="Transparent" BorderThickness="0" Foreground="#FF555555" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="{Binding HighlightImage}" Height="14" Width="14" Margin="0,0,6,0" />
                                <TextBlock Text="Highlight" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Image Source="{Binding Image}" MaxHeight="70" Margin="0,5,0,0" Stretch="Uniform"/>
                    </StackPanel>
                </Border>

                <!-- Input Text Section -->
                <TextBlock Margin="2,0,0,2">
                    <Run Text="Text" FontWeight="SemiBold" Foreground="#FF444444" />
                    <Run Text=" *" Foreground="Red" />
                    <Run Text=" (harus dalam tanda kutip)" FontSize="10" Foreground="Gray"/>
                </TextBlock>

                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.Text, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                    ExpressionType="{x:Type s:String}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="&quot;Ketik teks di sini&quot;"
                    MaxLines="3" MinLines="2" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" />

                <!-- Quick Options Section -->
                <Border BorderBrush="#FFE5E5E5" BorderThickness="1" Background="White" Padding="6">
                    <WrapPanel Orientation="Horizontal" ItemWidth="130">
                        <TextBlock Text="{Binding Path=ModelItem.EmptyField.Expression, StringFormat='Empty Field: {0}'}"
                                   FontSize="10" Foreground="#FF666666" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Path=ModelItem.ClickBeforeTyping.Expression, StringFormat='Click Before: {0}'}"
                                   FontSize="10" Foreground="#FF666666" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Path=ModelItem.SimulateKeystrokes.Expression, StringFormat='Simulate Type: {0}'}"
                                   FontSize="10" Foreground="#FF666666" Margin="0,2,0,2" />
                    </WrapPanel>
                </Border>

            </StackPanel>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </sap:ActivityDesigner.Resources>

    <Grid>
        <ContentPresenter Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
    </Grid>
</sap:ActivityDesigner>