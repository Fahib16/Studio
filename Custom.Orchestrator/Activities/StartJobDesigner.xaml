<sap:ActivityDesigner
    x:Class="Custom.Orchestrator.Activities.StartJobDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    >
    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Orchestrator;component/Resources/startjob.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>
    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Orchestrator;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>
    <Grid MinWidth="195">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.Orchestrator;component/Resources/startjob.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="Bold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="125" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1,1,1,0"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <TextBlock Margin="0,4,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Process Name" FontWeight="SemiBold" />
                    <Run Text=" *" Foreground="Red" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.ProcessName, Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}" HintText="nama proses di ForgeHub"
                    UseLocationExpression="False" MaxLines="1" MinWidth="180" />
                <TextBlock Margin="0,4,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Job Id (keluaran)" FontWeight="SemiBold" />
                    
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.JobId, Converter={StaticResource ArgToExpr},
                                         ConverterParameter=Out, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}" HintText="variabel String"
                    UseLocationExpression="True" MaxLines="1" MinWidth="180" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="#FFF7F1E4" Padding="8,4">
            <TextBlock FontSize="9" Foreground="#FF8A7A63" TextWrapping="Wrap" Text="Bawaannya TIDAK menunggu selesai. Robot, prioritas, dan argumen di panel Properties." />
        </Border>
    </Grid>
</sap:ActivityDesigner>
