<sap:ActivityDesigner
    x:Class="Custom.Flow.Activities.ForEachDataRowDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sa="clr-namespace:System.Activities;assembly=System.Activities"
    xmlns:sd="clr-namespace:System.Data;assembly=System.Data"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Flow;component/Resources/foreachdatarow.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Flow;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.Flow;component/Resources/foreachdatarow.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="Bold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="105" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Untuk tiap" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="#FF6B5B4B" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Path=ModelItem.Body.Argument.Name, Mode=TwoWay}"
                             MinWidth="60" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="di" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="#FF6B5B4B" Margin="6,0,6,0" />
                    <sapv:ExpressionTextBox
                        Expression="{Binding Path=ModelItem.DataTable,
                                             Converter={StaticResource ArgToExpr},
                                             ConverterParameter=In, Mode=TwoWay}"
                        OwnerActivity="{Binding Path=ModelItem}"
                        ExpressionType="sd:DataTable"
                        HintText="DataTable" MaxLines="1" MinWidth="130" />
                </StackPanel>
                <sap:WorkflowItemPresenter Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                                           HintText="Letakkan activity di sini"
                                           AllowedItemType="sa:Activity" MinHeight="40" />
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
