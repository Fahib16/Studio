<sap:ActivityDesigner
    x:Class="OpenRPA.Activities.Custom.Design.UiPathStyleAttachBrowserDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation">

    <sap:ActivityDesigner.Icon>
        <DrawingBrush>
            <DrawingBrush.Drawing>
                <ImageDrawing>
                    <ImageDrawing.Rect>
                        <Rect Location="0,0" Size="16,16" />
                    </ImageDrawing.Rect>
                    <ImageDrawing.ImageSource>
                        <BitmapImage UriSource="/OpenRPA;component/Resources/attachbrowser.png" />
                    </ImageDrawing.ImageSource>
                </ImageDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <!-- Warna ungu untuk kategori "Browser/Container", beda dari UI Automation
         biasa (biru) dan Data (hijau) — konsisten dengan gaya UiPath yang
         memberi warna berbeda tiap kategori activity -->
    <sap:ActivityDesigner.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF9B51E0" />
    </sap:ActivityDesigner.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3" Padding="6,3" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" Foreground="White" FontSize="13" Margin="0,0,6,0" />
                <TextBlock Text="Attach Browser" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Kriteria pencarian tab/browser -->
        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1"
                CornerRadius="2" Padding="6" Margin="0,0,0,4" Background="White">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <TextBlock Text="Selector:" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               FontWeight="SemiBold" Foreground="#FF555555" />
                    <TextBox DockPanel.Dock="Right" MinWidth="120"
                             Text="{Binding Path=ModelItem.Selector.Expression, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Url Pattern:" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               FontWeight="SemiBold" Foreground="#FF555555" />
                    <TextBox DockPanel.Dock="Right" MinWidth="120"
                             Text="{Binding Path=ModelItem.UrlPattern.Expression, Mode=TwoWay}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Ringkasan opsi -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
            <TextBlock Text="{Binding Path=ModelItem.BrowserType, StringFormat='Type: {0}'}"
                       FontSize="10" Foreground="#FF888888" />
        </StackPanel>

        <!-- Drop-zone untuk activity anak (Body) — inilah yang membedakan
             container activity dari activity biasa seperti Click/TypeInto.
             Child activities di-drag ke sini, dieksekusi dalam scope browser
             yang berhasil di-attach. Pola ini identik dengan drop-zone milik
             ForEach<T>/Sequence bawaan WF Designer. -->
        <Border Grid.Row="3" BorderBrush="#FF9B51E0" BorderThickness="1.5" CornerRadius="2" Padding="8" MinHeight="60"
                Background="#FFF8F4FD">
            <sap:WorkflowItemPresenter
                Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                HintText="Drop activities here (dalam scope Browser)"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</sap:ActivityDesigner>
