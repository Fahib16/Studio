<sap:ActivityDesigner
    x:Class="Custom.Terminal.Design.TypeIntoTerminalDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    >

    <sap:ActivityDesigner.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1B5E20" />
    </sap:ActivityDesigner.Resources>

    <Border Background="{StaticResource HeaderBrush}"
            CornerRadius="3" Padding="8,4" MinWidth="200">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🖊" Foreground="White" FontSize="13" Margin="0,0,6,0" />
            <TextBlock Text="Type Into Terminal" Foreground="White" FontWeight="Bold" FontSize="12" />
        </StackPanel>
    </Border>
</sap:ActivityDesigner>
