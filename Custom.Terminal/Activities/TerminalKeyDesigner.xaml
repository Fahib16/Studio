<sap:ActivityDesigner
    x:Class="Custom.Terminal.Design.TerminalKeyDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Terminal;component/Resources/sendterminalkey.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Terminal;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Border Background="{StaticResource HeaderBrush}"
            CornerRadius="3" Padding="8,4" MinWidth="165">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Custom.Terminal;component/Resources/sendterminalkey.png" Width="14" Height="14"
                   Margin="0,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Send Terminal Key" Foreground="White" FontWeight="Bold" FontSize="11" />
        </StackPanel>
    </Border>
</sap:ActivityDesigner>
