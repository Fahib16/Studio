<sap:ActivityDesigner
    x:Class="Custom.Terminal.Design.TerminalSessionDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >

    <!-- Icon custom sengaja tidak dipakai (lihat catatan IOException batch sebelumnya) -->

    <sap:ActivityDesigner.Resources>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
        <!-- Warna hijau tua, kategori "Terminal/Mainframe" — beda dari UI Automation
             (biru), Data (hijau muda), Browser/Window (ungu) yang sudah ada -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1B5E20" />
    </sap:ActivityDesigner.Resources>

    <Grid Margin="8" MinWidth="260">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖳" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Terminal Session" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1"
                CornerRadius="2" Padding="6" Margin="0,0,0,6" Background="White">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <TextBlock Text="Host:" DockPanel.Dock="Left" Width="45"
                               VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF555555" />
                    <sapv:ExpressionTextBox
                        Expression="{Binding Path=ModelItem.Host, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                        ExpressionType="{x:Type s:String}"
                        OwnerActivity="{Binding Path=ModelItem}"
                        HintText="mainframe.example.com"
                        MaxLines="1" MinLines="1" />
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Port:" DockPanel.Dock="Left" Width="45"
                               VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF555555" />
                    <sapv:ExpressionTextBox
                        Expression="{Binding Path=ModelItem.Port, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                        ExpressionType="{x:Type s:Int32}"
                        OwnerActivity="{Binding Path=ModelItem}"
                        HintText="23"
                        MaxLines="1" MinLines="1" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Drop-zone untuk activity anak, pola sama dengan AttachBrowser/AttachWindow -->
        <Border Grid.Row="2" BorderBrush="#FF1B5E20" BorderThickness="1.5" CornerRadius="2" Padding="8" MinHeight="50"
                Background="#FFE8F5E9">
            <sap:WorkflowItemPresenter
                Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                HintText="Drop activities here (dalam scope Terminal Session)"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</sap:ActivityDesigner>
