<shared:PathDesignerBase
    x:Class="Custom.Files.Design.WaitForDownloadDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:shared="clr-namespace:Custom.Shared;assembly=Custom.Shared"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Files;component/Resources/waitfordownload.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Files;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <!--
        Kartu sengaja dibuat RINGKAS. Sebelumnya empat bagian ditumpuk di
        kanvas (Do, folder, hasil, akhiran yang diabaikan) sehingga kartunya
        jauh lebih tinggi daripada activity lain di sekitarnya. "Akhiran berkas
        sementara" jarang diubah, jadi ia pindah ke panel Properties saja.
    -->
    <Grid MinWidth="215">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="3,3,0,0" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.Files;component/Resources/waitfordownload.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="Bold" FontSize="11"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="110" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource JF.CardBorder}" BorderThickness="1"
                CornerRadius="0,0,3,3" Background="{DynamicResource JF.CardBody}" Padding="8,6">
            <StackPanel>

                <!--
                    Kotak "Do": activity yang MEMICU unduhan diletakkan di sini.
                    Isi folder dicatat sebelum activity itu dijalankan, jadi
                    berkas lama tidak mungkin dikira hasil unduhan baru.
                -->
                <TextBlock Text="Activity yang memicu unduhan" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource JF.CardLabel}" Margin="0,0,0,3" />
                <Border BorderBrush="{DynamicResource JF.CardBorder}" BorderThickness="1" CornerRadius="4"
                        Background="{DynamicResource JF.Panel}" Padding="5" MinHeight="34">
                    <sap:WorkflowItemPresenter Item="{Binding Path=ModelItem.Body, Mode=TwoWay}"
                                               HintText="Letakkan activity di sini (mis. Click tombol Download)"
                                               MinHeight="26" />
                </Border>

                <TextBlock Margin="0,7,0,2" FontSize="10" Foreground="{DynamicResource JF.CardLabel}">
                    <Run Text="Folder yang dipantau" FontWeight="SemiBold" />
                    <Run Text=" *" Foreground="#FFC0392B" />
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <sapv:ExpressionTextBox Grid.Column="0"
                        Expression="{Binding Path=ModelItem.DownloadsFolder,
                                             Converter={StaticResource ArgToExpr},
                                             ConverterParameter=In, Mode=TwoWay}"
                        OwnerActivity="{Binding Path=ModelItem}"
                        HintText="Folder unduhan" MaxLines="1" MinWidth="145" />
                    <Button Grid.Column="1" Margin="4,0,0,0" Padding="6,1" Click="Browse_Click"
                            Tag="DownloadsFolder|folder|"
                            ToolTip="Pilih folder yang dipantau">...</Button>
                </Grid>

                <!-- Hasilnya FileInfo: .FullName untuk lokasi, .Name untuk nama berkas. -->
                <TextBlock Text="Berkas hasil unduhan (FileInfo)" Margin="0,7,0,2" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource JF.CardLabel}" />
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.DownloadedFile,
                                         Converter={StaticResource ArgToExpr},
                                         ConverterParameter=Out, Mode=TwoWay}"
                    UseLocationExpression="True"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="variabel FileInfo" MaxLines="1" MinWidth="160" />
            </StackPanel>
        </Border>
    </Grid>
</shared:PathDesignerBase>
