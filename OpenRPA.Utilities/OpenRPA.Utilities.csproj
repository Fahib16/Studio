  <ItemGroup>
    <!-- Disamakan dengan OpenRPA dan Custom.Excel, yang keduanya memakai
         0.105.1. Seluruh proyek menyalin ke SATU folder keluaran, jadi satu
         proyek yang tertinggal versi sudah cukup untuk menjatuhkan yang lain.
         rakitan 0.95.4.0 yang mendarat membuat activity yang dikompilasi
         terhadap 0.105.1.0 gagal dengan "manifest definition does not match".
         Penyakit yang sama pernah terjadi pada Newtonsoft.Json dan
         System.ValueTuple. -->
    <!-- Wajib disebut EKSPLISIT, walau kodenya sendiri tidak memakai tuple.
         Proyek .NET Framework yang memakai pustaka netstandard2.0 dilengkapi
         MSBuild dengan shim System.ValueTuple 4.0.2.0 dari
         Microsoft.NET.Build.Extensions. Seluruh proyek menyalin ke SATU folder
         keluaran, jadi proyek yang membangun TERAKHIR menentukan versi yang
         mendarat, dan shim itu menimpa 4.0.3.0 yang diminta OpenRPA, membuat
         pemuatan gagal dengan "manifest definition does not match".
         Menyebut paketnya secara eksplisit membuat proyek ini menyalin 4.0.3.0
         juga, sehingga siapa pun yang terakhir hasilnya sama. -->
    <!-- Disamakan dengan OpenRPA (6.0.0) dan dengan pengalihan versi di berkas
         config, yang memang menunjuk 6.0.0.0. Tanpa penyebutan eksplisit,
         proyek ini menarik versi lama secara transitif; karena seluruh proyek
         menyalin ke SATU folder keluaran, proyek yang membangun terakhir
         menentukan versi yang mendarat. Sebelas rakitan meminta 6.0.0.0,
         termasuk Roslyn, jadi versi lama yang mendarat adalah ranjau. -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
    <PackageReference Include="iTextSharp" Version="5.5.13.2" />
  </ItemGroup>
