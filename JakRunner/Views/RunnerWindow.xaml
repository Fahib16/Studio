<Window x:Class="JakRunner.Views.RunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JakRunner" Height="720" Width="1000"
        MinHeight="560" MinWidth="900"
        Background="{DynamicResource Runner.Surface}"
        FontFamily="{DynamicResource Runner.Font}"
        Foreground="{DynamicResource Runner.Text}"
        WindowStartupLocation="CenterScreen">

    <!--
        Dua tampilan dalam satu jendela.

        Bagian kiri selalu ada: menu samping, kartu ringkasan, dan tabel status
        agen. Lajur kanan berisi rincian agen dan hanya muncul saat dilebarkan —
        lebar JENDELA yang berubah, bukan isinya yang dipadatkan, supaya bagian
        kiri terbaca sama persis di kedua keadaan.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- ============ Menu samping ============ -->
        <Border Grid.Column="0" Width="215" Background="{DynamicResource Runner.Sidebar}"
                BorderBrush="{DynamicResource Runner.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,22,18,26">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Runner.Brown}">
                        <TextBlock Text="JR" Foreground="{DynamicResource Runner.Surface}"
                                   FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="JakRunner" FontSize="19" FontWeight="Bold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Runner.Brown}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0,12,0">
                    <RadioButton x:Name="NavBeranda" Style="{StaticResource Runner.NavItem}"
                                 IsChecked="True" Tag="beranda" Checked="Nav_Checked" Content="Beranda" />
                    <RadioButton x:Name="NavJadwal" Style="{StaticResource Runner.NavItem}"
                                 Tag="jadwal" Checked="Nav_Checked" Content="Jadwal" />
                    <RadioButton x:Name="NavLog" Style="{StaticResource Runner.NavItem}"
                                 Tag="log" Checked="Nav_Checked" Content="Log" />
                    <RadioButton x:Name="NavPengaturan" Style="{StaticResource Runner.NavItem}"
                                 Tag="pengaturan" Checked="Nav_Checked" Content="Pengaturan" />
                    <RadioButton x:Name="NavProfil" Style="{StaticResource Runner.NavItem}"
                                 Tag="profil" Checked="Nav_Checked" Content="Profil" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="18,0,18,20">
                    <TextBlock x:Name="HubStatusText" FontSize="11"
                               Foreground="{DynamicResource Runner.Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Isi utama ============ -->
        <Grid Grid.Column="1" Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Judul dan pencarian -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PageTitle" Grid.Column="0" Text="Dasbor Agen Pelari"
                           FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Runner.Brown}" />

                <Border Grid.Column="1" Background="{DynamicResource Runner.Card}"
                        BorderBrush="{DynamicResource Runner.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="12,9" MinWidth="270" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="SearchPlaceholder" Text="Cari Agen atau Log"
                                   Foreground="{DynamicResource Runner.Muted}" FontSize="13"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 FontSize="13" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Kartu ringkasan -->
            <Grid Grid.Row="1" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Runner.CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Agen Aktif" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Runner.Muted}" />
                        <TextBlock x:Name="StatAgents" Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Runner.CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Automasi Berjalan" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Runner.Muted}" />
                        <TextBlock x:Name="StatRunning" Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Runner.CardBorder}" Margin="0,0,12,0"
                        Background="{DynamicResource Runner.GreenSoft}">
                    <StackPanel>
                        <TextBlock Text="Berhasil Hari Ini" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Runner.Muted}" />
                        <TextBlock x:Name="StatSuccess" Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Runner.Green}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Runner.CardBorder}"
                        Background="{DynamicResource Runner.RedSoft}">
                    <StackPanel>
                        <TextBlock Text="Gagal Hari Ini" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Runner.Muted}" />
                        <TextBlock x:Name="StatFailed" Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Runner.Red}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tabel automasi -->
            <Border Grid.Row="2" Style="{StaticResource Runner.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="TableTitle" Text="Status Agen" Style="{StaticResource Runner.SectionTitle}" />
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="12.5"
                                   Foreground="{DynamicResource Runner.Muted}" />
                    </Grid>

                    <!-- Kepala kolom -->
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.9*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nama Automasi" Style="{StaticResource Runner.ColumnHead}" />
                        <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource Runner.ColumnHead}" />
                        <TextBlock Grid.Column="2" Text="Automasi Aktif" Style="{StaticResource Runner.ColumnHead}" />
                        <TextBlock Grid.Column="3" Text="Kinerja CPU/Memori" Style="{StaticResource Runner.ColumnHead}" />
                        <TextBlock Grid.Column="4" Text="Detail" Style="{StaticResource Runner.ColumnHead}" />
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Runner.Border}" BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AutomationList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Runner.Border}" BorderThickness="0,0,0,1"
                                                Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.9*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="11.5"
                                                               Foreground="{DynamicResource Runner.Muted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        CornerRadius="11" Padding="11,4"
                                                        Background="{Binding StateBackground}">
                                                    <TextBlock Text="{Binding StateText}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StateForeground}" />
                                                </Border>

                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5"
                                                           Foreground="{DynamicResource Runner.Muted}"
                                                           Text="{Binding Message}" TextWrapping="Wrap" />

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CpuText}" FontSize="12.5" />
                                                    <TextBlock Text="{Binding MemoryText}" FontSize="12.5"
                                                               Foreground="{DynamicResource Runner.Muted}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Runner.Round}" Width="30" Height="30"
                                                            Background="{DynamicResource Runner.Green}"
                                                            Click="Play_Click" Tag="{Binding}"
                                                            IsEnabled="{Binding IsIdle}"
                                                            ToolTip="Jalankan automasi ini">
                                                        <Path Data="M6,4 L14,9 L6,14 Z" Fill="White"
                                                              Width="18" Height="18" Stretch="None" />
                                                    </Button>

                                                    <Button Style="{StaticResource Runner.IconButton}"
                                                            Click="Detail_Click" Tag="{Binding}"
                                                            ToolTip="Lihat rincian">
                                                        <Path Data="M4,10 L8,6 L12,10" Stroke="{DynamicResource Runner.Text}"
                                                              StrokeThickness="1.7" Width="16" Height="16"
                                                              Stretch="None" StrokeLineJoin="Round" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Kaki -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <!--
                    Tiga kelompok tombol, masing-masing di kolomnya sendiri.

                    Sebelumnya ketiganya ditumpuk di satu sel dengan
                    HorizontalAlignment saja; begitu jendela menyempit, tombol
                    tengah yang lebar menutupi "Hentikan" di kiri.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource Runner.Flat}" Click="Refresh_Click" Content="Muat ulang" />
                    <Button x:Name="StopButton" Style="{StaticResource Runner.Flat}" Margin="8,0,0,0"
                            Click="Stop_Click" Content="Hentikan" IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Button x:Name="AssignButton" Style="{StaticResource Runner.Primary}"
                            Click="Assign_Click" Content="TUGASKAN AUTOMASI BARU" />
                    <TextBlock Text="Pilih automasi untuk dijalankan" FontSize="11.5"
                               Foreground="{DynamicResource Runner.Muted}"
                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                </StackPanel>

                <Button x:Name="ExpandButton" Grid.Column="2" Style="{StaticResource Runner.Flat}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Expand_Click" Content="Lebarkan  ›" />
            </Grid>
        </Grid>

        <!-- ============ Lajur rincian ============ -->
        <Border Grid.Column="2" Background="{DynamicResource Runner.Surface}"
                BorderBrush="{DynamicResource Runner.Border}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="22,22,22,22">

                    <TextBlock x:Name="DetailTitle" Text="Detail Agen Diperluas"
                               FontSize="19" FontWeight="Bold" Margin="0,0,0,18"
                               Foreground="{DynamicResource Runner.Brown}" TextWrapping="Wrap" />

                    <TextBlock Text="Log Aktivitas Terbaru" Style="{StaticResource Runner.SectionTitle}" />
                    <Border Style="{StaticResource Runner.CardBorder}" Padding="14" Margin="0,0,0,18">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,1"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Bracketed, Mode=OneWay}"
                                                 Foreground="{DynamicResource Runner.Muted}" />
                                            <Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="Daftar Kesalahan (Error List)" Style="{StaticResource Runner.SectionTitle}" />
                    <Border Style="{StaticResource Runner.CardBorder}" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ErrorList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,5,9,0"
                                                         VerticalAlignment="Top"
                                                         Fill="{DynamicResource Runner.Red}" />
                                                <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap">
                                                    <Run Text="{Binding Bracketed, Mode=OneWay}"
                                                         Foreground="{DynamicResource Runner.Muted}" />
                                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoErrorText" Text="Belum ada kesalahan."
                                       FontSize="12" Foreground="{DynamicResource Runner.Muted}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Parameter Input/Output" Style="{StaticResource Runner.SectionTitle}" />
                    <Border Style="{StaticResource Runner.CardBorder}" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <ItemsControl x:Name="ParameterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12.5"
                                                       Foreground="{DynamicResource Runner.Muted}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoParameterText"
                                       Text="Belum ada. Parameter keluaran muncul setelah automasi selesai."
                                       FontSize="12" Foreground="{DynamicResource Runner.Muted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Parameter Kinerja Rinci" Style="{StaticResource Runner.SectionTitle}" />
                    <Border Style="{StaticResource Runner.CardBorder}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Runner.Accent}"
                                    CornerRadius="8" Padding="11,8" Margin="0,0,6,8">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="11.5" Foreground="{DynamicResource Runner.Muted}" />
                                    <TextBlock x:Name="CpuText" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Runner.Accent}"
                                    CornerRadius="8" Padding="11,8" Margin="6,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Memori" FontSize="11.5" Foreground="{DynamicResource Runner.Muted}" />
                                    <TextBlock x:Name="MemText" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Runner.Accent}"
                                    CornerRadius="8" Padding="11,8" Margin="0,0,6,8">
                                <StackPanel>
                                    <TextBlock Text="Core" FontSize="11.5" Foreground="{DynamicResource Runner.Muted}" />
                                    <TextBlock x:Name="CoreText" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Runner.Accent}"
                                    CornerRadius="8" Padding="11,8" Margin="6,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Thread" FontSize="11.5" Foreground="{DynamicResource Runner.Muted}" />
                                    <TextBlock x:Name="ThreadText" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="Diukur untuk proses JakRunner, bukan seluruh mesin."
                                       FontSize="11" Foreground="{DynamicResource Runner.Muted}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
