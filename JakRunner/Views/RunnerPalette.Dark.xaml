<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palet GELAP.
        Kuncinya sama persis dengan palet terang; lihat catatan di sana.

        Bukan sekadar warna terang yang dibalik. Latar gelap membuat warna
        jenuh terasa menyala dan sulit dibaca lama-lama, jadi hijau, kuning,
        dan merahnya DITURUNKAN kejenuhannya sekaligus DINAIKKAN kecerahannya
        supaya tetap terbaca di atas latar gelap.

        Latar paling gelap dipakai untuk halamannya, bukan untuk kartunya:
        kartu yang lebih terang daripada latarnya membuat susunan bertingkat
        tetap terbaca, sama seperti di mode terang tapi terbalik arah.
    -->

    <SolidColorBrush x:Key="Runner.Bg"        Color="#1C1814" />
    <SolidColorBrush x:Key="Runner.Surface"   Color="#242019" />
    <SolidColorBrush x:Key="Runner.Card"      Color="#2B261E" />
    <SolidColorBrush x:Key="Runner.Sidebar"   Color="#211D17" />
    <SolidColorBrush x:Key="Runner.Border"    Color="#3D362C" />
    <SolidColorBrush x:Key="Runner.Text"      Color="#EDE5D8" />
    <SolidColorBrush x:Key="Runner.Muted"     Color="#A2957F" />
    <SolidColorBrush x:Key="Runner.Brown"     Color="#E3D8C6" />
    <SolidColorBrush x:Key="Runner.Accent"    Color="#3A3227" />

    <SolidColorBrush x:Key="Runner.Green"     Color="#5FCB8B" />
    <SolidColorBrush x:Key="Runner.GreenSoft" Color="#22392C" />
    <SolidColorBrush x:Key="Runner.Amber"     Color="#E5B356" />
    <SolidColorBrush x:Key="Runner.AmberSoft" Color="#3B3120" />
    <SolidColorBrush x:Key="Runner.Red"       Color="#E8796B" />
    <SolidColorBrush x:Key="Runner.RedSoft"   Color="#3C2723" />
    <SolidColorBrush x:Key="Runner.Blue"      Color="#6FA6F0" />

</ResourceDictionary>
