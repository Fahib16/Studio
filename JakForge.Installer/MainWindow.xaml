<Window x:Class="JakForge.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pasang JakForge Studio"
        Height="600" Width="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#FAF7EE"
        FontFamily="Segoe UI, Century Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Palet JakForge (varian terang), disalin dari Themes\JakForgePalette.Light.xaml.
             Disalin dan bukan direferensi karena pemasang ini sengaja berdiri
             sendiri: ia tidak boleh bergantung pada DLL yang justru sedang
             ia pasang. -->
        <SolidColorBrush x:Key="Cream"     Color="#FAF7EE" />
        <SolidColorBrush x:Key="Surface"   Color="#FFFDF8" />
        <SolidColorBrush x:Key="Sidebar"   Color="#EFE8DA" />
        <SolidColorBrush x:Key="Panel"     Color="#F5F0E6" />
        <SolidColorBrush x:Key="Border"    Color="#E2D8C6" />
        <SolidColorBrush x:Key="Tan"       Color="#C9A87C" />
        <SolidColorBrush x:Key="TrackFill" Color="#A07E59" />
        <SolidColorBrush x:Key="Track"     Color="#E7DBCB" />
        <SolidColorBrush x:Key="Ink"       Color="#433326" />
        <SolidColorBrush x:Key="Muted"     Color="#7A6A58" />
        <SolidColorBrush x:Key="Ok"        Color="#4C8A5C" />
        <SolidColorBrush x:Key="Danger"    Color="#B4472E" />

        <Style x:Key="Judul" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Century Gothic, Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style x:Key="Kecil" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Tombol utama -->
        <Style x:Key="TombolUtama" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFDF8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="30,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource TrackFill}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#8C6B4A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#D8CCBA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol samar -->
        <Style x:Key="TombolSamar" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Panel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol tutup di bilah judul -->
        <Style x:Key="TombolTutup" TargetType="Button">
            <Setter Property="Foreground" Value="#E7DBCB" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#B4472E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bilah judul sendiri: WindowStyle=None membuang bilah bawaan
                 Windows, jadi seret-untuk-memindah harus disediakan sendiri. -->
            <Border Grid.Row="0" Background="{StaticResource Ink}" MouseLeftButtonDown="BilahJudul_Seret">
                <Grid>
                    <TextBlock Text="JakForge Studio" Foreground="#EFE8DA" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               FontFamily="Century Gothic, Segoe UI" />
                    <Button x:Name="TombolTutupJendela" Style="{StaticResource TombolTutup}"
                            Content="✕" HorizontalAlignment="Right" Click="Tutup_Klik" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <!-- ================= LAYAR 1: sambutan & pilihan ================= -->
                <Grid x:Name="LayarSambutan" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Sidebar}">
                        <StackPanel VerticalAlignment="Center" Margin="28,0">
                            <Image Width="96" HorizontalAlignment="Left"
                                   Source="Resources/logo_mark.png" Stretch="Uniform" />
                            <Image Width="150" HorizontalAlignment="Left" Margin="0,14,0,0"
                                   Source="Resources/logo_wordmark.png" Stretch="Uniform" />
                            <TextBlock Text="Studio" Style="{StaticResource Judul}" FontSize="20" Margin="0,4,0,0" />
                            <TextBlock x:Name="TeksVersi" Style="{StaticResource Kecil}" Margin="0,6,0,0" Text="versi —" />
                            <Rectangle Height="1" Fill="{StaticResource Border}" Margin="0,20,0,16" />
                            <TextBlock Style="{StaticResource Kecil}"
                                       Text="Dipasang hanya untuk akun Windows ini. Tidak perlu hak administrator." />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="34,34,34,0">
                        <TextBlock Text="Pasang JakForge Studio" Style="{StaticResource Judul}" />
                        <TextBlock Style="{StaticResource Kecil}" Margin="0,10,0,0"
                                   Text="Semua langkah di bawah dikerjakan otomatis. Yang tersisa hanya satu konfirmasi dari peramban Anda, dan itu dijelaskan di akhir." />

                        <TextBlock Text="DIPASANG DI" Foreground="{StaticResource Muted}" FontSize="11"
                                   Margin="0,22,0,6" />
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="KotakFolder" Grid.Column="0" BorderThickness="0"
                                         Background="Transparent" Foreground="{StaticResource Ink}"
                                         VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Ubah…" Style="{StaticResource TombolSamar}"
                                        Padding="10,4" FontSize="12" Click="UbahFolder_Klik" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,20,0,0">
                            <CheckBox x:Name="CentangPeramban" IsChecked="True">
                                <TextBlock TextWrapping="Wrap">
                                    Pasang jembatan peramban untuk <Run FontWeight="SemiBold">Chrome</Run> dan
                                    <Run FontWeight="SemiBold">Edge</Run>
                                </TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="CentangDesktop" IsChecked="True" Content="Buat pintasan di Desktop" />
                            <CheckBox x:Name="CentangJalankan" IsChecked="True" Content="Jalankan Studio setelah selesai" />
                        </StackPanel>

                        <Border x:Name="PeringatanProses" Background="#FFEBD3" BorderBrush="{StaticResource Tan}"
                                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TeksPeringatan" TextWrapping="Wrap"
                                       Foreground="{StaticResource Ink}" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="34,0,34,28">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Batal" Style="{StaticResource TombolSamar}"
                                    Margin="0,0,10,0" Click="Tutup_Klik" />
                            <Button x:Name="TombolPasang" Content="Pasang" Style="{StaticResource TombolUtama}"
                                    Click="Pasang_Klik" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= LAYAR 2: sedang memasang ================= -->
                <Grid x:Name="LayarProses" Visibility="Collapsed" Background="{StaticResource Cream}">
                    <StackPanel VerticalAlignment="Center" Margin="60,0">
                        <TextBlock Text="Memasang…" Style="{StaticResource Judul}" />
                        <TextBlock x:Name="TeksLangkah" Style="{StaticResource Kecil}" Margin="0,12,0,0"
                                   Text="Menyiapkan" />

                        <Border Background="{StaticResource Track}" CornerRadius="3" Height="6" Margin="0,22,0,0">
                            <Border x:Name="BatangProgres" Background="{StaticResource TrackFill}"
                                    CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                        </Border>

                        <TextBlock x:Name="TeksPersen" Style="{StaticResource Kecil}" Margin="0,8,0,0" Text="0%" />
                    </StackPanel>
                </Grid>

                <!-- ================= LAYAR 3: selesai ================= -->
                <Grid x:Name="LayarSelesai" Visibility="Collapsed" Background="{StaticResource Cream}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Bisa digulir: isi kotak "langkah tersisa" tumbuh sesuai
                         peramban yang terdeteksi dan memuat jalan cadangan, jadi
                         tingginya tidak bisa dipastikan di muka. Tanpa ini, justru
                         bagian cadangan — yang paling dibutuhkan saat ada yang
                         salah — yang terpotong di bawah. -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  Padding="46,26,46,10">
                        <StackPanel>
                            <TextBlock x:Name="JudulSelesai" Text="Terpasang" Style="{StaticResource Judul}" />
                            <TextBlock x:Name="RingkasanSelesai" Style="{StaticResource Kecil}" Margin="0,10,0,0" />

                            <Border x:Name="KotakLangkahTerakhir" Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Tan}" BorderThickness="1"
                                    CornerRadius="4" Padding="14,12" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Satu langkah tersisa, di peramban Anda"
                                               Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TeksLangkahTerakhir" Style="{StaticResource Kecil}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,0,34,28">
                        <Button x:Name="TombolBukaEkstensi" Content="Buka halaman ekstensi"
                                Style="{StaticResource TombolSamar}" Margin="0,0,10,0" Click="BukaEkstensi_Klik" />
                        <Button Content="Selesai" Style="{StaticResource TombolUtama}" Click="Selesai_Klik" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
