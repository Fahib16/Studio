<sap:ActivityDesigner
    x:Class="CustomSystem.Design.RetryScopeDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sa="clr-namespace:System.Activities;assembly=System.Activities"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.System;component/Resources/retryscope.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.System;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="3" Padding="8,4" MinWidth="150">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Custom.System;component/Resources/retryscope.png" Width="14" Height="14"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Path=ModelItem.DisplayName}"
                               Foreground="White" FontWeight="Bold" FontSize="12" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <DataTemplate x:Key="Expanded">
            <Grid MinWidth="230">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                        CornerRadius="3,3,0,0" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔁" Foreground="White" FontSize="12" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Foreground="White" FontWeight="Bold" FontSize="12"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 CaretBrush="White" MinWidth="120" />
                    </StackPanel>
                </Border>

                <!-- Tiga nilai ini yang biasanya disetel ulang tiap kali Retry Scope
                     dipakai; ContinueOnError tetap di Properties panel. -->
                <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1,0,1,0"
                        Background="#FFFFFDF8" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Retries" FontSize="10"
                                   FontWeight="SemiBold" Foreground="#FF6B5B4B"
                                   VerticalAlignment="Center" Margin="0,0,8,4" />
                        <sapv:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                            Expression="{Binding Path=ModelItem.NumberOfRetries,
                                                 Converter={StaticResource ArgToExpr},
                                                 ConverterParameter=In, Mode=TwoWay}"
                            OwnerActivity="{Binding Path=ModelItem}"
                            HintText="3" MaxLines="1" MinWidth="120" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Interval" FontSize="10"
                                   FontWeight="SemiBold" Foreground="#FF6B5B4B"
                                   VerticalAlignment="Center" Margin="0,0,8,4" />
                        <sapv:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                            Expression="{Binding Path=ModelItem.RetryInterval,
                                                 Converter={StaticResource ArgToExpr},
                                                 ConverterParameter=In, Mode=TwoWay}"
                            OwnerActivity="{Binding Path=ModelItem}"
                            HintText="00:00:05" MaxLines="1" MinWidth="120" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Condition" FontSize="10"
                                   FontWeight="SemiBold" Foreground="#FF6B5B4B"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- Condition bertipe Activity(Of Boolean), BUKAN Argument,
                             jadi di-bind langsung tanpa ArgumentToExpressionConverter
                             dan ExpressionType-nya disebut eksplisit. Pola sama
                             dengan BreakableWhileDesigner di project OpenRPA. -->
                        <sapv:ExpressionTextBox Grid.Row="2" Grid.Column="1"
                            Expression="{Binding Path=ModelItem.Condition, Mode=TwoWay}"
                            ExpressionType="{x:Type s:Boolean}"
                            OwnerActivity="{Binding Path=ModelItem}"
                            HintText="opsional, hasilnya harus True"
                            MaxLines="1" MinWidth="120" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="#FFE2D8C6" BorderThickness="1"
                        CornerRadius="0,0,3,3" Background="#FFFFFDF8">
                    <StackPanel Margin="8">
                        <Border Background="#FFF5F0E6" CornerRadius="3,3,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="10" Foreground="#FF6B5B4B" Margin="0,0,6,0" />
                                <TextBlock Text="Do" FontWeight="SemiBold" FontSize="11" Foreground="#FF3E3226" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#FF4A3B2F" BorderThickness="1.5" Padding="8" MinHeight="40"
                                Background="#FFF3EDE1" Margin="0,1,0,0">
                            <sap:WorkflowItemPresenter
                                Item="{Binding Path=ModelItem.Body, Mode=TwoWay}"
                                AllowedItemType="{x:Type sa:Activity}"
                                IsDefaultContainer="True"
                                HintText="Drop Activity Here"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <ContentPresenter Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
</sap:ActivityDesigner>
