<sap:ActivityDesigner
    x:Class="CustomSystem.Design.LogMessageDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:CustomSystem"
    >


    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.System;component/Resources/logmessage.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.System;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- ExpressionTextBox TIDAK BISA di-bind langsung ke .Expression;
             wajib lewat converter ini dengan ConverterParameter=In. -->
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />

        <ObjectDataProvider x:Key="LevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:LogMessageLevel" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="165">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.System;component/Resources/logmessage.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- Judul di-bind ke DisplayName dan bisa langsung diketik ulang di
                     canvas, jadi activity bisa dinamai tanpa membuka Properties. -->
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="Bold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="105" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <!-- Hanya Message dan Level yang ditaruh di kartu: keduanya harus
                     diisi ulang setiap kali activity dipakai. ContinueOnError
                     jarang disentuh dan tetap di Properties panel. -->
                <TextBlock Margin="0,0,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Message" FontWeight="SemiBold" />
                    <Run Text=" *" Foreground="Red" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.Message,
                                         Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="Pesan yang ditulis ke log"
                    MaxLines="1" MinWidth="150" />

                <TextBlock Margin="0,8,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Level" FontWeight="SemiBold" />
                </TextBlock>
                <ComboBox ItemsSource="{Binding Source={StaticResource LevelValues}}"
                          SelectedItem="{Binding Path=ModelItem.Level, Mode=TwoWay}"
                          MinWidth="105" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
