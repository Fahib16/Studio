<sap:ActivityDesigner
    x:Class="CustomDatabase.Design.DatabaseScopeDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    >
    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Database;component/Resources/dbscope.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>
    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Database;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>
    <Grid MinWidth="230">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.Database;component/Resources/dbscope.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="Bold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="150" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1,1,1,0"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <TextBlock Margin="0,0,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Connection String" FontWeight="SemiBold" />
                    <Run Text=" *" Foreground="Red" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.ConnectionString, Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="Server=(localdb)\MSSQLLocalDB;Integrated Security=true;"
                    MaxLines="2" MinWidth="215" />

                <TextBlock Margin="0,6,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Provider Name" FontWeight="SemiBold" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.ProviderName, Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="kosong = System.Data.SqlClient"
                    MaxLines="1" MinWidth="215" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="#FFF7F1E4" Padding="6">
            <sap:WorkflowItemPresenter
                Item="{Binding Path=ModelItem.Body.Handler}"
                HintText="Taruh activity basis data di sini"
                MinHeight="60" />
        </Border>
    </Grid>
</sap:ActivityDesigner>
