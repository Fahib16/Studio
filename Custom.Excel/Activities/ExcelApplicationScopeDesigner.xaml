<shared:PathDesignerBase
    x:Class="Custom.Excel.Design.ExcelApplicationScopeDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sa="clr-namespace:System.Activities;assembly=System.Activities"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:shared="clr-namespace:Custom.Shared;assembly=Custom.Shared"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Excel;component/Resources/excelscope.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Excel;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="3" Padding="8,4" MinWidth="165">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Custom.Excel;component/Resources/excelscope.png" Width="14" Height="14"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Path=ModelItem.DisplayName}"
                               Foreground="White" FontWeight="Bold" FontSize="12" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <DataTemplate x:Key="Expanded">
            <Grid MinWidth="245">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                        CornerRadius="3,3,0,0" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📗" Foreground="White" FontSize="12" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Foreground="White" FontWeight="Bold" FontSize="12"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 CaretBrush="White" MinWidth="135" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1,0,1,0"
                        Background="#FFFFFDF8" Padding="8,5">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,2" FontSize="10" Foreground="#FF6B5B4B">
                            <Run Text="Workbook Path" FontWeight="SemiBold" />
                            <Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <sapv:ExpressionTextBox Grid.Column="0"
                                Expression="{Binding Path=ModelItem.WorkbookPath,
                                                     Converter={StaticResource ArgToExpr},
                                                     ConverterParameter=In, Mode=TwoWay}"
                                OwnerActivity="{Binding Path=ModelItem}"
                                HintText="Berkas .xlsx"
                                MaxLines="1" MinWidth="182" />
                            <!-- Tombol pemilih berkas (lihat Custom.Shared.PathDesignerBase).
                                 Mode save, bukan file: Create If Missing memang membolehkan
                                 berkas yang belum ada. -->
                            <Button Grid.Column="1" Margin="4,0,0,0" Padding="6,1" Click="Browse_Click"
                                    Tag="WorkbookPath|save|Berkas Excel (*.xlsx;*.xlsm)|*.xlsx;*.xlsm|Semua berkas (*.*)|*.*"
                                    ToolTip="Pilih dari komputer" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="11" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="#FFE2D8C6" BorderThickness="1"
                        CornerRadius="0,0,3,3" Background="#FFFFFDF8">
                    <StackPanel Margin="8">
                        <Border Background="#FFF5F0E6" CornerRadius="3,3,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="10" Foreground="#FF6B5B4B" Margin="0,0,6,0" />
                                <TextBlock Text="Do" FontWeight="SemiBold" FontSize="11" Foreground="#FF3E3226" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#FF5E6B45" BorderThickness="1.5" Padding="8" MinHeight="40"
                                Background="#FFF1EEDF" Margin="0,1,0,0">
                            <sap:WorkflowItemPresenter
                                Item="{Binding Path=ModelItem.Body, Mode=TwoWay}"
                                AllowedItemType="{x:Type sa:Activity}"
                                IsDefaultContainer="True"
                                HintText="Drop Activity Here"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <ContentPresenter Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
</shared:PathDesignerBase>
