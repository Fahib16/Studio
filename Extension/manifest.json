{
  "manifest_version": 3,
  "name": "Studio Automation Bridge",
  "version": "0.12.0",
  "description": "Indicate on screen, UI Explorer, interaksi elemen, dan tab management untuk Studio.",

  "key": "",

  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Studio Automation Bridge"
  }
}
