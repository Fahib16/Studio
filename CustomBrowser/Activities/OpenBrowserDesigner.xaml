<sap:ActivityDesigner
    x:Class="Custom.Browser.Design.OpenBrowserDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >


    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Browser;component/Resources/openbrowser.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Browser;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <StackPanel Margin="6">
                <TextBlock Text="{Binding Path=ModelItem.Url.Expression, TargetNullValue='[belum diisi]'}"
                           FontStyle="Italic" Foreground="#FF3E3226" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <DataTemplate x:Key="Expanded">
            <Grid Margin="8" MinWidth="215">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Label "Url *" ala UiPath, tanda bintang merah krn RequiredArgument -->
                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Margin="0,0,0,2">
                        <Run Text="Url" FontWeight="SemiBold" Foreground="#FF6B5B4B" />
                        <Run Text=" *" Foreground="Red" />
                    </TextBlock>
                    <sapv:ExpressionTextBox
                        Expression="{Binding Path=ModelItem.Url, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                        ExpressionType="{x:Type s:String}"
                        OwnerActivity="{Binding Path=ModelItem}"
                        HintText="https://example.com"
                        MaxLines="1" MinLines="1" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Path=ModelItem.BrowserType, StringFormat='Browser: {0}'}"
                                   FontSize="10" Foreground="#FF9A8B78" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Path=ModelItem.NewTab.Expression, StringFormat='New Tab: {0}'}"
                                   FontSize="10" Foreground="#FF9A8B78" />
                    </StackPanel>
                </StackPanel>

                <!-- Sub-card "Do" ala UiPath — header sendiri + drop-zone di dalamnya -->
                <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="3" Background="#FFFFFDF8">
                    <StackPanel>
                        <Border Background="#FFF5F0E6" CornerRadius="3,3,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="10" Foreground="#FF6B5B4B" Margin="0,0,6,0" />
                                <TextBlock Text="Do" FontWeight="SemiBold" FontSize="11" Foreground="#FF3E3226" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#FFA0703F" BorderThickness="1.5" Padding="8" MinHeight="40"
                                Background="#FFF3EDE1" Margin="1">
                            <sap:WorkflowItemPresenter
                                Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                                HintText="Drop Activity Here"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <!-- Header biru ala UiPath: ikon + judul. ▲/▼ collapse ditangani lewat
         ShowExpanded binding di atas (DataTrigger Collapsed/Expanded) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.Browser;component/Resources/openbrowser.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Open Browser" Foreground="White" FontWeight="Bold" FontSize="12" />
            </StackPanel>
        </Border>
        <ContentPresenter Grid.Row="1" Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
    </Grid>
</sap:ActivityDesigner>
