<sap:ActivityDesigner
    x:Class="Custom.Browser.Design.OpenBrowserDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >

    <!-- Icon custom sengaja tidak dipakai (lihat catatan IOException batch sebelumnya) -->

    <sap:ActivityDesigner.Resources>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1565C0" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <StackPanel Margin="6">
                <TextBlock Text="{Binding Path=ModelItem.Url.Expression, TargetNullValue='[belum diisi]'}"
                           FontStyle="Italic" Foreground="#FF444444" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <DataTemplate x:Key="Expanded">
            <Grid Margin="8" MinWidth="260">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Label "Url *" ala UiPath, tanda bintang merah krn RequiredArgument -->
                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Margin="0,0,0,2">
                        <Run Text="Url" FontWeight="SemiBold" Foreground="#FF555555" />
                        <Run Text=" *" Foreground="Red" />
                    </TextBlock>
                    <sapv:ExpressionTextBox
                        Expression="{Binding Path=ModelItem.Url, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                        ExpressionType="{x:Type s:String}"
                        OwnerActivity="{Binding Path=ModelItem}"
                        HintText="https://example.com"
                        MaxLines="1" MinLines="1" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Path=ModelItem.BrowserType, StringFormat='Browser: {0}'}"
                                   FontSize="10" Foreground="#FF888888" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Path=ModelItem.NewTab.Expression, StringFormat='New Tab: {0}'}"
                                   FontSize="10" Foreground="#FF888888" />
                    </StackPanel>
                </StackPanel>

                <!-- Sub-card "Do" ala UiPath — header sendiri + drop-zone di dalamnya -->
                <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="3" Background="White">
                    <StackPanel>
                        <Border Background="#FFF5F5F5" CornerRadius="3,3,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="11" Foreground="#FF555555" Margin="0,0,6,0" />
                                <TextBlock Text="Do" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#FF1565C0" BorderThickness="1.5" Padding="8" MinHeight="50"
                                Background="#FFE3F2FD" Margin="1">
                            <sap:WorkflowItemPresenter
                                Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                                HintText="Drop Activity Here"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </sap:ActivityDesigner.Resources>

    <!-- Header biru ala UiPath: ikon + judul. ▲/▼ collapse ditangani lewat
         ShowExpanded binding di atas (DataTrigger Collapsed/Expanded) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Open Browser" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>
        <ContentPresenter Grid.Row="1" Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
    </Grid>
</sap:ActivityDesigner>
