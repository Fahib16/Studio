<sap:ActivityDesigner
    x:Class="Custom.Browser.Design.AttachBrowserDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    >

    <!-- Icon custom sengaja tidak dipakai (lihat catatan IOException batch sebelumnya) -->

    <sap:ActivityDesigner.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1565C0" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="3" Padding="10,6" MinWidth="180">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌐" Foreground="White" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Attach Browser" Foreground="White" FontWeight="Bold" FontSize="13" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <!-- Header + link "Indicate browser on screen" + drop-zone "Do",
             mirip persis layout UiPath.Core.Activities.BrowserScope. -->
        <DataTemplate x:Key="Expanded">
            <Grid MinWidth="260">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                        CornerRadius="3,3,0,0" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" Foreground="White" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Attach Browser" Foreground="White" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1,0,1,0" Background="White" Padding="10,8">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="⋯" Click="OpenSelector_Click"
                                Padding="6,2" ToolTip="Buka Selector picker" />
                        <TextBlock VerticalAlignment="Center">
                            <Hyperlink Click="OpenSelector_Click">
                                <Run Text="Indicate browser on screen" />
                            </Hyperlink>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="0,0,3,3" Background="White">
                    <StackPanel Margin="8">
                        <Border Background="#FFF5F5F5" CornerRadius="3,3,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="11" Foreground="#FF555555" Margin="0,0,6,0" />
                                <TextBlock Text="Do" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#FF1565C0" BorderThickness="1.5" Padding="8" MinHeight="50"
                                Background="#FFE3F2FD" Margin="0,1,0,0">
                            <sap:WorkflowItemPresenter
                                Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                                HintText="Drop Activity Here"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </sap:ActivityDesigner.Resources>

    <ContentPresenter Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
</sap:ActivityDesigner>
