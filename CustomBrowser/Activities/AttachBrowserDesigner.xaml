<sap:ActivityDesigner
    x:Class="Custom.Browser.Design.AttachBrowserDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    >


    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Browser;component/Resources/attachbrowser.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Browser;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- ExpressionTextBox tidak bisa di-bind langsung ke .Expression;
             wajib lewat converter ini (ConverterParameter=In untuk InArgument). -->
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />

        <!-- ===================== COLLAPSED VIEW ===================== -->
        <DataTemplate x:Key="Collapsed">
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="3" Padding="8,4" MinWidth="150">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Custom.Browser;component/Resources/attachbrowser.png" Width="14" Height="14"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Attach Browser" Foreground="White" FontWeight="Bold" FontSize="12" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== EXPANDED VIEW ===================== -->
        <!-- Header + kotak Url + tautan "Indicate browser on screen" +
             drop-zone "Do", mengikuti layout BrowserScope UiPath. Kotak Url
             menggantikan tampilan selector OpenRPA yang lama. -->
        <DataTemplate x:Key="Expanded">
            <Grid MinWidth="215">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                        CornerRadius="3,3,0,0" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Custom.Browser;component/Resources/attachbrowser.png" Width="14" Height="14"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Attach Browser" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1,0,1,0" Background="#FFFFFDF8" Padding="8,5">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,2" FontSize="10" Foreground="#FF6B5B4B">
                            <Run Text="Url" FontWeight="SemiBold" />
                        </TextBlock>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="⋯" Click="OpenSelector_Click"
                                    Padding="6,2" Margin="4,0,0,0"
                                    ToolTip="Pilih tab browser yang sedang terbuka" />
                            <sapv:ExpressionTextBox
                                Expression="{Binding Path=ModelItem.Url,
                                                     Converter={StaticResource ArgToExpr},
                                                     ConverterParameter=In, Mode=TwoWay}"
                                OwnerActivity="{Binding Path=ModelItem}"
                                HintText="mis. rpachallenge.com"
                                MaxLines="1" MinWidth="135" />
                        </DockPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="10">
                            <Hyperlink Click="OpenSelector_Click">
                                <Run Text="Indicate browser on screen" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3" Background="#FFFFFDF8">
                    <StackPanel Margin="8">
                        <Border Background="#FFF5F0E6" CornerRadius="3,3,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="10" Foreground="#FF6B5B4B" Margin="0,0,6,0" />
                                <TextBlock Text="Do" FontWeight="SemiBold" FontSize="11" Foreground="#FF3E3226" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#FFA0703F" BorderThickness="1.5" Padding="8" MinHeight="40"
                                Background="#FFF3EDE1" Margin="0,1,0,0">
                            <sap:WorkflowItemPresenter
                                Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                                HintText="Drop Activity Here"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExpandOrCollapsedStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate" Value="{DynamicResource Expanded}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ShowExpanded}" Value="false">
                    <Setter Property="ContentTemplate" Value="{DynamicResource Collapsed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <ContentPresenter Style="{DynamicResource ExpandOrCollapsedStyle}" Content="{Binding}" />
</sap:ActivityDesigner>
