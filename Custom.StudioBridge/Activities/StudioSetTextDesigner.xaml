<bridge:IndicateDesignerBase
    x:Class="Custom.StudioBridge.Design.StudioSetTextDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:bridge="clr-namespace:Custom.StudioBridge.Design"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.StudioBridge;component/Resources/typeinto.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.StudioBridge;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />
        <bridge:Base64ToImageSourceConverter x:Key="Base64Converter" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="190">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="4,4,0,0" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.StudioBridge;component/Resources/typeinto.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="SemiBold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="120" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFE0D8CC" BorderThickness="1" CornerRadius="0,0,4,4"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <!-- Baris Indicate SERAGAM untuk semua kartu berselector. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock>
                        <Hyperlink Click="Indicate_Click" Foreground="#FF8A5A2B">
                            <Run Text="Indicate on screen" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" | " Foreground="#FFBBAF9F" />
                    <TextBlock>
                        <Hyperlink Click="EditSelector_Click" Foreground="#FF8A5A2B">
                            <Run Text="Edit selector" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Screenshot elemen hasil Indicate; disembunyikan sampai
                     benar-benar ada, supaya kartu tetap ringkas. -->
                <Border BorderBrush="#FFE0D8CC" BorderThickness="1" Margin="0,6,0,0"
                        HorizontalAlignment="Center" Padding="1" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=ModelItem.ScreenshotBase64}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=ModelItem.ScreenshotBase64}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="{Binding Path=ModelItem.ScreenshotBase64, Converter={StaticResource Base64Converter}}"
                           MaxHeight="160" MaxWidth="320"
                           Stretch="Uniform" SnapsToDevicePixels="True" />
                </Border>

                <!-- Hanya Text yang inline — satu-satunya nilai yang selalu diisi ulang tiap pemakaian. -->
                <TextBlock Margin="0,8,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Text" FontWeight="SemiBold" />
                    <Run Text=" *" Foreground="#FFC0392B" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.Text,
                                         Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="Teks yang mau diketik"
                    MaxLines="1" MinWidth="150" />
            </StackPanel>
        </Border>
    </Grid>
</bridge:IndicateDesignerBase>
