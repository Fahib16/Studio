<Window x:Class="Custom.StudioBridge.Design.TabPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilih Tab" Height="320" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tab mana yang mau di-indicate?" FontWeight="SemiBold" Margin="0,0,0,8" />

        <ListBox Grid.Row="1" x:Name="TabListBox" DisplayMemberPath="Display" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Batal" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Pilih" Width="80" Click="Select_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
