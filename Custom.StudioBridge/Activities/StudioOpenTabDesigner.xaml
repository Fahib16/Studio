<sap:ActivityDesigner
    x:Class="Custom.StudioBridge.Design.StudioOpenTabDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >

    <sap:ActivityDesigner.Resources>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF00897B" />
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="260">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" Foreground="White" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Studio Open Tab" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1,0,1,0"
                Background="White" Padding="10,8">
            <StackPanel>
                <TextBlock Margin="0,0,0,2">
                    <Run Text="Url" FontWeight="SemiBold" Foreground="#FF555555" />
                    <Run Text=" *" Foreground="Red" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.Url, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                    ExpressionType="{x:Type s:String}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="https://example.com"
                    MaxLines="1" MinLines="1" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="0,0,3,3" Background="White">
            <StackPanel Margin="8">
                <Border Background="#FFF5F5F5" CornerRadius="3,3,0,0" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontSize="11" Foreground="#FF555555" Margin="0,0,6,0" />
                        <TextBlock Text="Do" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="#FF00897B" BorderThickness="1.5" Padding="8" MinHeight="50"
                        Background="#FFE0F2F1" Margin="0,1,0,0">
                    <sap:WorkflowItemPresenter
                        Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                        HintText="Drop Activity Here"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
