<sap:ActivityDesigner
    x:Class="Custom.StudioBridge.Design.StudioOpenTabDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sac="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.StudioBridge;component/Resources/opentab.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.StudioBridge;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <sac:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="215">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.StudioBridge;component/Resources/opentab.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Studio Open Tab" Foreground="White" FontWeight="Bold" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1,0,1,0"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <TextBlock Margin="0,0,0,2">
                    <Run Text="Url" FontWeight="SemiBold" Foreground="#FF6B5B4B" />
                    <Run Text=" *" Foreground="Red" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.Url, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}"
                    ExpressionType="{x:Type s:String}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="https://example.com"
                    MaxLines="1" MinLines="1" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3" Background="#FFFFFDF8">
            <StackPanel Margin="8">
                <Border Background="#FFF5F0E6" CornerRadius="3,3,0,0" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontSize="10" Foreground="#FF6B5B4B" Margin="0,0,6,0" />
                        <TextBlock Text="Do" FontWeight="SemiBold" FontSize="11" Foreground="#FF3E3226" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="#FF6E5844" BorderThickness="1.5" Padding="8" MinHeight="40"
                        Background="#FFF1EEDF" Margin="0,1,0,0">
                    <sap:WorkflowItemPresenter
                        Item="{Binding Path=ModelItem.Body.Handler, Mode=TwoWay}"
                        HintText="Drop Activity Here"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
