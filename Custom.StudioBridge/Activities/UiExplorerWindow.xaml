<Window x:Class="Custom.StudioBridge.Design.UiExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI Explorer — Studio Bridge"
        Height="700" Width="1180"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- IsExpanded/IsSelected di-bind dua arah supaya kode bisa membuka
             dan menyorot node target secara terprogram setelah pohon dimuat. -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <!-- Baris atribut dipakai di dua daftar (Selected dan Unselected),
             jadi templatenya dibagi supaya keduanya pasti tampil sama. -->
        <DataTemplate x:Key="AttributeRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center"
                           Foreground="#FF555555" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFF3F3F3" BorderBrush="#FFDDDDDD" BorderThickness="1"
                Padding="8,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ValidateButton" Style="{StaticResource ToolButton}"
                        Background="#FF2E7D32" Foreground="White" FontWeight="Bold"
                        Content="Validate" Click="Validate_Click" />
                <Button Style="{StaticResource ToolButton}" MinWidth="120"
                        Content="Indicate Element" Click="Indicate_Click" />
                <Button Style="{StaticResource ToolButton}"
                        Content="Highlight" Click="Highlight_Click" />
                <Button Style="{StaticResource ToolButton}"
                        Content="Refresh Tree" Click="Refresh_Click" />
                <TextBlock x:Name="TabLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#FF666666" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Kiri: Visual Tree di atas, Property Explorer di bawah -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Visual Tree">
                    <TreeView x:Name="DomTreeView"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              SelectedItemChanged="DomTreeView_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Display}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="Transparent" />

                <GroupBox Grid.Row="2" Header="Property Explorer">
                    <DataGrid x:Name="PropertyGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Property" Width="120" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Tengah: Selector Editor berjenjang -->
            <GroupBox Grid.Column="2" Header="Selector Editor">
                <ListBox x:Name="NodeList" SelectionChanged="NodeList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Display}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF1565C0" />
                                            <Style.Triggers>
                                                <!-- Tingkat yang tidak ikut ditampilkan pudar,
                                                     supaya sekali lihat ketahuan mana yang
                                                     benar-benar membentuk selector. -->
                                                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                    <Setter Property="Foreground" Value="#FFAAAAAA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Kanan: atribut tingkat yang sedang disorot -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Selected Items" MaxHeight="220">
                    <ListBox x:Name="SelectedAttrList" ItemTemplate="{StaticResource AttributeRow}"
                             HorizontalContentAlignment="Stretch" FontSize="11"
                             BorderThickness="0" MinHeight="60" />
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Unselected Items" Margin="0,6,0,0">
                    <ListBox x:Name="UnselectedAttrList" ItemTemplate="{StaticResource AttributeRow}"
                             HorizontalContentAlignment="Stretch" FontSize="11"
                             BorderThickness="0" />
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Selector hasil -->
        <GroupBox Grid.Row="2" Header="Selector" Margin="0,8,0,0">
            <TextBox x:Name="SelectorTextBox" MinHeight="70" MaxHeight="130"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     TextChanged="SelectorTextBox_TextChanged" />
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFEEEEEE" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="8,4">
                    <TextBlock x:Name="TargetLabel" Text="Target Element: (belum ada)" FontSize="11" />
                </Border>
                <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" Width="90" Padding="0,5" Click="Save_Click" IsDefault="True" />
                <Button Content="Cancel" Width="90" Padding="0,5" Margin="8,0,0,0"
                        Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
