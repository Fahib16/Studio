<sap:ActivityDesigner
    x:Class="Custom.StudioBridge.Design.StudioAttachTabDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    >

    <sap:ActivityDesigner.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF00897B" />
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔗" Foreground="White" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Studio Attach Tab" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="White" Padding="10,8">
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink Click="Indicate_Click">
                    <Run Text="Pick from open tabs" />
                </Hyperlink>
            </TextBlock>
        </Border>
    </Grid>
</sap:ActivityDesigner>
