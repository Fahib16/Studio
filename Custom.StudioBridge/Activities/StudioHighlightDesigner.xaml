<sap:ActivityDesigner
    x:Class="Custom.StudioBridge.Design.StudioHighlightDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:local="clr-namespace:Custom.StudioBridge.Design"
    >

    <sap:ActivityDesigner.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF00897B" />
        <local:Base64ToImageSourceConverter x:Key="Base64Converter" />
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔆" Foreground="White" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Studio Highlight" Foreground="White" FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="White" Padding="10,8">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink Click="Indicate_Click">
                        <Run Text="Indicate on screen" />
                    </Hyperlink>
                </TextBlock>
                <!-- BARU: screenshot elemen hasil Indicate terakhir, mirip
                     Informative Screenshot UiPath. Kosong/tidak render
                     kalau belum pernah di-Indicate (Source null aman). -->
                <Image Source="{Binding Path=ModelItem.ScreenshotBase64, Converter={StaticResource Base64Converter}}"
                       MaxHeight="80" MaxWidth="220" Margin="0,6,0,0"
                       Stretch="Uniform" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
