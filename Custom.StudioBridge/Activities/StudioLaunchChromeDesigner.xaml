<sap:ActivityDesigner
    x:Class="Custom.StudioBridge.Design.StudioLaunchChromeDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    >

    <sap:ActivityDesigner.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF00897B" />
    </sap:ActivityDesigner.Resources>

    <Border Background="{StaticResource HeaderBrush}" CornerRadius="3" Padding="10,6" MinWidth="200">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🚀" Foreground="White" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Studio Launch Chrome" Foreground="White" FontWeight="Bold" FontSize="13" />
        </StackPanel>
    </Border>
</sap:ActivityDesigner>
