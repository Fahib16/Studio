<sap:ActivityDesigner
    x:Class="Custom.Data.Design.FilterDataTableDesigner"
    Template="{DynamicResource JF.CardTemplate}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
    >

    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <ImageDrawing Rect="0,0,16,16" ImageSource="/Custom.Data;component/Resources/filterdatatable.png" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>

    <sap:ActivityDesigner.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Custom.Data;component/Resources/JakForgeCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- ExpressionTextBox TIDAK BISA di-bind langsung ke .Expression;
             wajib lewat converter ini (ConverterParameter=In untuk InArgument,
             Out + UseLocationExpression untuk OutArgument). -->
        <sapc:ArgumentToExpressionConverter x:Key="ArgToExpr" />
        </ResourceDictionary>
    </sap:ActivityDesigner.Resources>

    <Grid MinWidth="165">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                CornerRadius="3,3,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Custom.Data;component/Resources/filterdatatable.png" Width="14" Height="14"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- Judul di-bind ke DisplayName supaya activity bisa dinamai
                     langsung di canvas tanpa membuka Properties panel. -->
                <TextBox Text="{Binding Path=ModelItem.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Foreground="White" FontWeight="Bold" FontSize="12"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="White" MinWidth="105" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFE2D8C6" BorderThickness="1" CornerRadius="0,0,3,3"
                Background="#FFFFFDF8" Padding="8,5">
            <StackPanel>
                <!-- Tabel sumber, ekspresi filter, dan variabel hasil inline; Select Columns dan Sort di Properties panel. -->
                <TextBlock Margin="0,0,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Data Table" FontWeight="SemiBold" />
                    <Run Text=" *" Foreground="Red" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.DataTable,
                                         Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="Tabel sumber"
                    MaxLines="1" MinWidth="150" />
                <TextBlock Margin="0,8,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Filter Expression" FontWeight="SemiBold" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.FilterExpression,
                                         Converter={StaticResource ArgToExpr},
                                         ConverterParameter=In, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    HintText="mis. Umur > 30 AND Kota = 'Jakarta'"
                    MaxLines="1" MinWidth="150" />
                <TextBlock Margin="0,8,0,2" FontSize="10" Foreground="#FF6B5B4B">
                    <Run Text="Save to" FontWeight="SemiBold" />
                </TextBlock>
                <sapv:ExpressionTextBox
                    Expression="{Binding Path=ModelItem.Result,
                                         Converter={StaticResource ArgToExpr},
                                         ConverterParameter=Out, Mode=TwoWay}"
                    OwnerActivity="{Binding Path=ModelItem}"
                    UseLocationExpression="True"
                    HintText="Variabel DataTable penampung hasil"
                    MaxLines="1" MinWidth="150" />
            </StackPanel>
        </Border>
    </Grid>
</sap:ActivityDesigner>
